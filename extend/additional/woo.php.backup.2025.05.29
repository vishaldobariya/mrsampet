    /*1. Modify Product Query Based on `plan` Parameter (title contains `plan`)*/
        add_action( 'pre_get_posts', 'filter_products_by_plan_param' );
        function filter_products_by_plan_param( $query ) {
            /* Exit early if 'plan' is not in the URL
                if ( ! isset( $_GET['plan'] ) || empty( $_GET['plan'] ) ) {
                    return;
                }
            
            // Only apply this filter on the main query and on the shop/archive/category pages
                if ( ! is_admin() && $query->is_main_query() && ( is_shop() || is_product_category() || is_search() ) ) {
                    // Get the 'plan' URL parameter
                    $plan = isset( $_GET['plan'] ) ? sanitize_text_field( $_GET['plan'] ) : '';
                    
                    if ( $plan ) {
                        // Modify the query to search product titles for the plan
                        $query->set( 's', $plan );  // This will modify the search term, effectively filtering the products by title
                    }
                }
            */
            if ( ! is_admin() && $query->is_main_query() && ( is_shop() || is_product_category() || is_search() ) ) {
                $raw_plan = isset( $_GET['plan'] ) ? trim( $_GET['plan'] ) : '';
                if ( $raw_plan !== '' ) {
                    $plan = sanitize_text_field( $raw_plan );
                }
                // If no valid 'plan' is provided, check if we should default it
                elseif ( is_product_category( 'health-check-up' ) || is_product_category( 'pet-grooming' ) ) {
                    $plan = 'Basic';
                }
                // Otherwise, exit early
                else {
                    return;
                }
        
                // Apply the search filter with the resolved plan
                $query->set( 's', $plan );
            }

            
        }        
    
    /**Change title of the products (bookable) to Vendor Name**/    
        function replace_product_title_with_store_name( $title, $id ) {
            // Only modify product titles on front-end product loops
            if ( is_admin() || ! ( is_shop() || is_product_category() || is_search() ) ) {
                return $title;
            }
        
            if ( get_post_type( $id ) !== 'product' ) {
                return $title;
            }
        
            // Check if the product is a booking product
            $product = wc_get_product( $id );
            if ( ! $product || $product->get_type() !== 'booking' ) {
                return $title;
            }
        
            // Get the author (vendor) ID
            $vendor_id = get_post_field( 'post_author', $id );
        
            // Get the store name using WCFM function
            if ( function_exists( 'wcfm_get_vendor_store_name' ) ) {
                $store_name = wcfm_get_vendor_store_name( $vendor_id );
                if ( $store_name ) {
                    return $store_name;
                }
            }
        
            return $title;
        }
        add_filter( 'the_title', 'replace_product_title_with_store_name', 10, 2 );

    
    /**Update pricing on shop/ archive pages to show resoure price based on url*/
        add_filter('woocommerce_get_price_html', 'custom_booking_price_with_vaccine_options', 20, 2);
        function custom_booking_price_with_vaccine_options($price_html, $product) {
            
            // Ensure we're on the correct pages (shop, category, or search)
            if (is_admin() || !(is_shop() || is_product_category() || is_search())) {
                return $price_html;
            }
        
            // Apply only to booking products
            if (!$product || $product->get_type() !== 'booking') {
                return $price_html;
            }
        
            // 1. Visit Resource Cost (Clinic or Home visit)
            $visit = isset($_GET['visit']) ? sanitize_text_field($_GET['visit']) : 'clinic';
            $resource_name = strtolower($visit . ' visit');
            $resource_ids = $product->get_resource_ids();
            $resource_cost = 0;
        
            if (!empty($resource_ids)) {
                foreach ($resource_ids as $resource_id) {
                    $resource = get_post($resource_id);
                    if ($resource && strtolower($resource->post_title) === $resource_name) {
                        $costs = get_post_meta($product->get_id(), '_resource_base_costs', true);
                        if (isset($costs[$resource_id])) {
                            $resource_cost = floatval($costs[$resource_id]);
                        }
                        break;
                    }
                }
            }
        
            // 2. Vaccine Cost (WPC Options)
            $vaccine_cost = 0;
        
            // Check if the product belongs to the vaccine category
            if (has_term('vaccine', 'product_cat', $product->get_id())) {
                $vaccine_param = isset($_GET['vaccine']) ? sanitize_text_field($_GET['vaccine']) : '';
                if (!empty($vaccine_param)) {
                    $selected_vaccines = array_map('trim', explode(',', $vaccine_param));
        
                    // Fetch the meta data (WPC Product Options)
                    $meta_raw = get_post_meta($product->get_id(), 'wpcpo-fields');
                    if (!empty($meta_raw) && is_array($meta_raw)) {
                        $wpcpo_fields = maybe_unserialize($meta_raw[0]);
        
                        if (is_array($wpcpo_fields)) {
                            foreach ($wpcpo_fields as $field) {
                                if (isset($field['options']) && is_array($field['options'])) {
                                    foreach ($field['options'] as $option) {
                                        $option_name = isset($option['name']) ? trim($option['name']) : '';
                                        $option_price = isset($option['price']) ? floatval($option['price']) : 0;
        
                                        // Check if the option is selected, and add the price
                                        if (in_array($option_name, $selected_vaccines)) {
                                            $vaccine_cost += $option_price;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        
            // 3. Combine Resource and Vaccine Prices
            $total_price = $resource_cost + $vaccine_cost;
        
            // Return the new calculated price if applicable, otherwise return the original price
            if ($total_price > 0) {
                return wc_price($total_price);
            }
        
            return $price_html;
        }

    /**Hide products with 0 pricing**/
       // add_action( 'woocommerce_product_query', 'wcfmwp_hide_products_without_price' );
        function wcfmwp_hide_products_without_price( $q ){
           $meta_query = $q->get( 'meta_query' );
           $meta_query[] = array(
              'key'       => '_price',
              'value'     => '0',
              'compare'   => '!='
           );
           $q->set( 'meta_query', $meta_query );
        }


    /**Update Button to carry forward parameters**/
        add_filter( 'woocommerce_loop_add_to_cart_link', 'custom_add_to_cart_button_with_url_params', 10, 2 );
        function custom_add_to_cart_button_with_url_params( $link, $product ) {
            // Check if we are on a shop or product category page
            if ( is_shop() || is_product_category() || is_search() ) {
                // Get the current URL parameters 'plan' and 'visit'
                $plan = isset( $_GET['plan'] ) ? sanitize_text_field( $_GET['plan'] ) : '';
                $visit = isset( $_GET['visit'] ) ? sanitize_text_field( $_GET['visit'] ) : '';
                $pet = isset( $_GET['pet'] ) ? sanitize_text_field( $_GET['pet'] ) : '';
                $vaccine = isset( $_GET['vaccine'] ) ? sanitize_text_field( $_GET['vaccine'] ) : '';
        
                // If we have parameters, append them to the product URL
                if ( $plan || $visit || $pet || $vaccine ) {
                    $product_url = get_permalink( $product->get_id() );
                    $product_url = add_query_arg( 'plan', $plan, $product_url );
                    if ( $visit ) {
                        $product_url = add_query_arg( 'visit', $visit, $product_url );
                    }
                    if ( $pet ) {
                        $product_url = add_query_arg( 'pet', $pet, $product_url );
                    }
                    if ( $vaccine ) {
                        $product_url = add_query_arg( 'vaccine', $vaccine, $product_url );
                    }
                    
                    // Replace the original Add to Cart URL with the modified URL
                    $link = str_replace( get_permalink( $product->get_id() ), $product_url, $link );
                }
            }
        
            return $link;
        }
        
    /** Modify the Add to Cart button text based on product type (bookable or not)**/
        add_filter( 'woocommerce_loop_add_to_cart_link', 'custom_change_add_to_cart_button_text_loop', 10, 2 );
        function custom_change_add_to_cart_button_text_loop( $link, $product ) {
            // Check if the product is a bookable product
            if ( $product->is_type( 'booking' ) ) {
                // Change the button text to "Book Now" for bookable products
                $link = str_replace( 'Select options', 'Book Now', $link );
            } else {
                // For non-bookable products, change the button text to "Buy Now"
                $link = str_replace( 'Select options', 'Buy Now', $link );
            }
            return $link;
        }
    
